# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co

# AI Services - OpenRouter
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
# Optional server-only aliases for /api/vision (falls back to VITE_OPENROUTER_API_KEY).
# OPENROUTER_API_KEY=your_openrouter_api_key
# VISION_MODEL=google/gemini-2.5-flash
# Required server-only key for /api/tts.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key

# AI Services - NVIDIA
VITE_NVIDIA_API_KEY=your_nvidia_api_key
VITE_NVIDIA_FLASH_API_KEY=your_nvidia_flash_api_key

# AI Services - Pixazo (Image Generation)
VITE_PIXAZO_API_KEY=your_pixazo_api_key
